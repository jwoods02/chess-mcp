# Copy to .env (gitignored) and fill in. Read by `pnpm dev` / `pnpm start`.

# TypeSafe AI key (System One API). Enables Jev as an opponent; leave empty to play without it.
TYPESAFE_AI_API_KEY=

# Jev model version (default: jev-latest). Others: jev-preview, jev-1.14.0, jev-1.13.0.
# JEV_MODEL=jev-latest

# PORT=3000
# DATABASE_PATH=data/chess.db
